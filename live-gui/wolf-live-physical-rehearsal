#!/usr/bin/env bash
# Ensaio completo do roteiro de instalação, EXCLUSIVAMENTE em modo leitura.
set -Eeuo pipefail
if (( $# != 1 )); then
    echo '[ERRO] Uso: wolf-live-physical-rehearsal /caminho/preview.json' >&2
    exit 2
fi
status=0
sudo -n wolf-install --rehearse-multidisk-physical "$1" || status=$?
printf '\n'
read -r -p "Ensaio físico finalizado (código $status). Pressione Enter para fechar... " _ || true
exit "$status"
