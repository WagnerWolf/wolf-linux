#!/usr/bin/env bash
# Resumo declarativo do plano; SEM chamada de instalação real.
set -Eeuo pipefail
if (( $# != 1 )); then
    echo '[ERRO] Uso: wolf-live-simulate-plan /caminho/preview.json' >&2
    exit 2
fi
status=0
sudo wolf-install --simulate-gui-plan "$1" || status=$?
printf '\n'
read -r -p "Simulação finalizada (código $status). Pressione Enter para fechar... " _ || true
exit "$status"
