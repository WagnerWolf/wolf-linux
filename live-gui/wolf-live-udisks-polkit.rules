// Somente na ISO Live Wolf: permitir que o usuário temporário monte partições
// pelo GVfs/UDisks2, sem executar o gerenciador de arquivos como root.
// NÃO concede autorização para formatar, criar/excluir partições nem editar LVM.
polkit.addRule(function(action, subject) {
    if (subject.user === "wolf" && subject.local === true && subject.active === true &&
        (action.id === "org.freedesktop.udisks2.filesystem-mount" ||
         action.id === "org.freedesktop.udisks2.filesystem-mount-system")) {
        return polkit.Result.YES;
    }
});
