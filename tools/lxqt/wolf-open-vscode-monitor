#!/usr/bin/env python3
"""Abre NOVA janela VS Code na tela do clique, sem serviço em segundo plano.

O Openbox prioriza o monitor do mouse para novas janelas, mas aplicativos
Electron podem restaurar posições antigas ou reutilizar uma instância.
Este comando observa somente a nova janela VS Code criada pela própria ação.
"""
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

CODE_CLASS = re.compile(r'(?:^|[.\-_])(code|code-oss|code-insiders|codium)(?:$|[.\-_])', re.I)
MONITOR = re.compile(r'(\d+)/(?:\d+)x(\d+)/(?:\d+)([+-]\d+)([+-]\d+)')


def run(*args):
    return subprocess.run(args, text=True, capture_output=True, check=False)


def monitor_under_pointer():
    if not os.environ.get('DISPLAY') or not shutil.which('xdotool') or not shutil.which('xrandr'):
        return None
    mouse = run('xdotool', 'getmouselocation', '--shell')
    if mouse.returncode:
        return None
    xy = dict(re.findall(r'^([XY])=(-?\d+)$', mouse.stdout, re.M))
    if not all(k in xy for k in ('X', 'Y')):
        return None
    x, y = int(xy['X']), int(xy['Y'])
    result = run('xrandr', '--listactivemonitors')
    if result.returncode:
        return None
    for line in result.stdout.splitlines()[1:]:
        m = MONITOR.search(line)
        if m:
            w, h, left, top = map(int, m.groups())
            if left <= x < left + w and top <= y < top + h:
                return left, top, w, h
    return None


def code_windows():
    if not shutil.which('wmctrl'):
        return set()
    result = run('wmctrl', '-lx')
    if result.returncode:
        return set()
    found = set()
    for line in result.stdout.splitlines():
        parts = line.split(None, 4)
        # wmctrl -lx: ID DESKTOP WM_CLASS HOST TITLE
        if len(parts) >= 4 and CODE_CLASS.search(parts[2]):
            found.add(parts[0].lower())
    return found


def is_maximized(window_id):
    if not shutil.which('xprop'):
        return False
    result = run('xprop', '-id', window_id, '_NET_WM_STATE')
    return '_NET_WM_STATE_MAXIMIZED_HORZ' in result.stdout or '_NET_WM_STATE_MAXIMIZED_VERT' in result.stdout


def move_window(window_id, rectangle):
    left, top, width, height = rectangle
    # Reposiciona só a janela nova, nunca as instâncias existentes.
    maximized = is_maximized(window_id)
    if maximized:
        run('wmctrl', '-ir', window_id, '-b', 'remove,maximized_vert,maximized_horz')
    # Posiciona perto do canto superior esquerdo do monitor destino.
    x, y = left + min(60, max(0, width // 15)), top + min(65, max(0, height // 12))
    moved = run('wmctrl', '-ir', window_id, '-e', f'0,{x},{y},-1,-1')
    if maximized:
        run('wmctrl', '-ir', window_id, '-b', 'add,maximized_vert,maximized_horz')
    return moved.returncode == 0


def main(argv):
    if len(argv) != 1:
        print('Uso: wolf-open-vscode-monitor DIRETORIO', file=sys.stderr)
        return 2
    path = Path(argv[0]).expanduser()
    if not path.is_dir():
        print(f'Diretório inválido: {path}', file=sys.stderr)
        return 2
    if not shutil.which('code'):
        print('VS Code não instalado: comando code ausente.', file=sys.stderr)
        return 127
    chosen = monitor_under_pointer()
    previous = code_windows() if chosen else set()
    # --new-window é essencial: não deslocar janelas preexistentes do usuário.
    try:
        subprocess.Popen(['code', '--new-window', '--', str(path.resolve())],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as exc:
        print(f'Erro ao iniciar VS Code: {exc}', file=sys.stderr)
        return 1
    if chosen and shutil.which('wmctrl'):
        until = time.monotonic() + 14
        while time.monotonic() < until:
            new = code_windows() - previous
            if new:
                # ID X11 geralmente crescente; restringir a janela recém-criada.
                newest = sorted(new, key=lambda wid: int(wid, 16))[-1]
                if move_window(newest, chosen):
                    break
            time.sleep(0.25)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
