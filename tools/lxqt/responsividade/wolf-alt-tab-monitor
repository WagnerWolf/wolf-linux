#!/usr/bin/env python3
"""Wolf LXQt Alt+Tab: lançamento mínimo, sem criar outro seletor."""
from __future__ import annotations
import fcntl
import os
from pathlib import Path
import socket
import subprocess
import sys
LIB = Path.home() / '.local' / 'lib' / 'wolf-alt-tab'
sys.path.insert(0, str(LIB))
from wolf_alt_common import lock_path, socket_path


def send(command: str) -> bool:
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        client.settimeout(0.14)
        with client:
            client.connect(str(socket_path()))
            client.sendall(command.encode('ascii') + b'\n')
        return True
    except (OSError, TimeoutError):
        return False


def run_fallback():
    # Segurança: mesmo se o serviço cair, não lançar seletores sobrepostos.
    fd = os.open(str(lock_path()) + '.fallback', os.O_CREAT | os.O_RDWR, 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        original = LIB / 'legacy_alt_tab.py'
        if original.is_file():
            return subprocess.call([sys.executable, str(original)] + (
                ['--reverse'] if '--reverse' in sys.argv else []))
        return 1
    finally:
        os.close(fd)


def main():
    if os.environ.get('XDG_SESSION_TYPE') not in (None, '', 'x11'):
        return 2
    command = 'PREV' if '--reverse' in sys.argv else 'NEXT'
    if send(command):
        return 0
    # Reinicia em caso de falha no autostart; o lock no servidor garante 1 só.
    daemon = LIB / 'wolf-alt-tab-daemon.py'
    if daemon.is_file():
        with open(os.devnull, 'wb') as devnull:
            subprocess.Popen([sys.executable, str(daemon), '--serve'],
                             stdin=devnull, stdout=devnull, stderr=devnull,
                             start_new_session=True, close_fds=True)
    # Primeiro uso na recuperação: não perder o Alt+Tab.
    return run_fallback()


if __name__ == '__main__':
    sys.exit(main())
