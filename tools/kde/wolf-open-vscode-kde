#!/usr/bin/env python3
"""Abre a pasta escolhida numa nova janela do VS Code, sem mexer em outras janelas.

KWin/Wayland posiciona novas janelas; não chamar wmctrl/xdotool (somente X11).
"""
from pathlib import Path
import shutil
import subprocess
import sys


def main(argv):
    if len(argv) != 1:
        print('Uso: wolf-open-vscode-kde PASTA', file=sys.stderr)
        return 2
    folder = Path(argv[0]).expanduser()
    if not folder.is_dir():
        print(f'Pasta não encontrada: {folder}', file=sys.stderr)
        return 2
    executable = shutil.which('code') or shutil.which('code-oss')
    if not executable:
        print('Visual Studio Code não encontrado (comando code).', file=sys.stderr)
        return 127
    try:
        subprocess.Popen([executable, '--new-window', '--', str(folder.resolve())],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as exc:
        print(f'Erro ao abrir VS Code: {exc}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
